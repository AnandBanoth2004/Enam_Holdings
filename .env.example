# Copy to .env for local development. Replace the local DB password placeholder.
FINN_APP_ENVIRONMENT=development
FINN_LOG_LEVEL=INFO
FINN_CORS_ORIGINS=http://localhost:3000
FINN_MARKET_TICKERS=RELIANCE,TCS,HDFCBANK,ICICIBANK,INFY,ITC,LT,SBIN,BHARTIARTL,AXISBANK,KOTAKBANK,HINDUNILVR,BAJFINANCE,MARUTI,SUNPHARMA,TATAMOTORS,TITAN,ASIANPAINT
FINN_MARKET_CACHE_TTL_SECONDS=21600
FINN_RESEARCH_API_BASE_URL=https://api.openai.com/v1
FINN_RESEARCH_MODEL=gpt-4o-mini
FINN_EMBEDDING_MODEL=text-embedding-3-small
FINN_EMBEDDING_DIMENSIONS=1536
FINN_DOCUMENT_MAX_FILE_BYTES=31457280
FINN_DOCUMENT_ALLOWED_HOSTS=
FINN_RESEARCH_MAX_CONTEXT_CHARS=18000
FINN_RESEARCH_RETRIEVAL_CACHE_SECONDS=300
FINN_AUTH_JWKS_URL=
FINN_AUTH_ISSUER=
FINN_AUTH_AUDIENCE=authenticated
FINN_DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:54322/postgres


#postgresql+psycopg://postgres:your-local-password@127.0.0.1:54322/postgres
# These are read by the Next.js server only. They are never NEXT_PUBLIC_* keys.
FINN_API_BASE_URL=http://localhost:8000
FINN_WORKSPACE_ID=3c39b2f3-b3f3-4f34-9b20-5fd985e64301

# Optional. Omit for keyword-ranked, extractive evidence responses.
# FINN_RESEARCH_API_KEY=
